# Required for protected API routes.
CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev

# Demo configuration. These values are the defaults, but set them explicitly in Vercel.
PATHRAK_DEMO_MODE=true
ROUTING_PROVIDER=osrm_demo
OSRM_BASE_URL=https://router.project-osrm.org
PATHRAK_DATA_MODE=demo

# Optional: required only when ROUTING_PROVIDER=ors.
ORS_API_KEY=

# Optional integration: set all three together to request real Twilio SMS messages.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional: required only when PATHRAK_DATA_MODE=real. The directory must be bundled read-only data.
PATHRAK_REAL_DATA_DIR=

# Optional: same-origin Vercel requests need no CORS allow-list. Useful for split local development.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
