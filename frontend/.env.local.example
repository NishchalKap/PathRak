# Required: public Clerk publishable key for the selected Clerk instance.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key

# Optional: an explicit split-development API origin. Leave unset to use the
# Vite /api proxy below or Vercel's same-origin /api routes.
# VITE_API_URL=http://127.0.0.1:8000

# Only used by Vite's local /api proxy when VITE_API_URL is left unset.
# This is not bundled into production and must point at the FastAPI server.
VITE_BACKEND_URL=http://127.0.0.1:8000
